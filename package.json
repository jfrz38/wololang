{
  "name": "wololang",
  "version": "0.1.1",
  "description": "An Age of Empires II taunt-based esoteric programming language powered by a Brainfuck-like VM.",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "bin": {
    "wololo": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "prepublishOnly": "pnpm run test && pnpm run build"
  },
  "keywords": [
    "esolang",
    "brainfuck",
    "age-of-empires",
    "taunts",
    "wololo"
  ],
  "author": "José F. Ruiz",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "26.3.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
